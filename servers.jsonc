{
  // Server definitions — one entry per llama.cpp or MLX server.
  // Add/remove entries freely. The launcher picks them up automatically.

  "llamacpp_bin": "~/llama.cpp-turbo/build/bin/llama-server",

  "servers": {
    "dense": {
      "backend": "llamacpp",
      "model": "~/.cache/huggingface/hub/models--unsloth--Qwen3.6-27B-GGUF/snapshots/82d411acf4a06cfb8d9b073a5211bf410bfc29bf/Qwen3.6-27B-UD-Q6_K_XL.gguf",
      "port": 30080,
      "args": ["-c", "8192"]
    },
    "moe": {
      "backend": "llamacpp",
      "model": "~/.localllm/models/Qwen3.6-35B-A3B-UD-Q6_K_XL.gguf",
      "port": 30081,
      "args": ["-c", "8192"]
    },
    "mtp-vision": {
      "backend": "llamacpp",
      "model": "~/.cache/huggingface/hub/models--unsloth--Qwen3.8-27B-GGUF/snapshots/990216cf312573f2ac4060279848e0f4237600c7/Qwen3.8-27B-UD-Q4_K_XL.gguf",
      "mmproj": "~/.cache/huggingface/hub/models--unsloth--Qwen3.8-27B-GGUF/snapshots/990216cf312573f2ac4060279848e0f4237600c7/mmproj-F16.gguf",
      "port": 30082,
      "args": [
        "-c", "262144",
        "--spec-type", "draft-mtp",
        "--spec-draft-n-max", "3"
      ]
    },
    "mlx-dense": {
      "backend": "mlx",
      "model": "~/.localllm/models/Qwen3.6-27B-UD-MLX-4bit",
      "port": 30090,
      "args": [
        "--prompt-cache-size", "50",
        "--decode-concurrency", "2",
        "--prompt-concurrency", "2",
        "--prefill-step-size", "2048",
        "--temp", "0.6",
        "--max-tokens", "32768",
        //"--turbo-kv-bits", "3",
        "--top-p", "0.95",
        "--top-k", "20",
        "--prompt-cache-bytes", "21474836480",
        "--prompt-cache-dir", "/Users/michael/.localllm/prompt_cache"
      ]
    },
    "mlx-moe-8bit": {
      "backend": "mlx",
      "model": "~/.cache/huggingface/hub/models--unsloth--Qwen3.6-35B-A3B-MLX-8bit/snapshots/d928611c119d7d86037d6926ac50712062ff0f29",
      "port": 30084,
      "args": [
        "--prompt-cache-size", "50",
        "--decode-concurrency", "4",
        "--prompt-concurrency", "4",
        "--prefill-step-size", "2048",
        "--temp", "0.6",
        "--max-tokens", "32768",
        "--top-p", "0.95",
        "--top-k", "20",
        "--prompt-cache-bytes", "21474836480",
        //"--turbo-kv-bits", "3",
        //"--kv-cache-quantization", "8,4",
        //"--quantized-kv-start", "0",
        "--prompt-cache-dir", "/Users/michael/.localllm/prompt_cache"
      ]
    },
    "mlx-moe": {
      "backend": "mlx",
      "model": "~/.localllm/models/Qwen3.6-35B-A3B-UD-MLX-4bit",
      "port": 30083,
      "args": [
        "--prompt-cache-size", "50",
        "--decode-concurrency", "4",
        "--prompt-concurrency", "4",
        "--prefill-step-size", "2048",
        "--temp", "0.6",
        "--max-tokens", "32768",
        "--top-p", "0.95",
        "--top-k", "20",
        "--prompt-cache-bytes", "21474836480",
        "--kv-cache-quantization", "8,4",
        "--quantized-kv-start", "0",
        "--prompt-cache-dir", "/Users/michael/.localllm/prompt_cache"
      ]
    },
    "mlx-dense-mtp": {
      "backend": "optiq",
      "model": "mlx-community/Qwen3.6-27B-OptiQ-4bit",
      "port": 30091,
      "args": [
        "--mtp",
        "--mtp-depth", "2",
        "--temp", "0.8",
        "--max-tokens", "32768",
        "--top-p", "0.95",
        "--top-k", "40",
        "--min-p", "0.05"
