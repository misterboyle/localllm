{
  // Server definitions — one entry per llama.cpp or MLX server.
  // Add/remove entries freely. The launcher picks them up automatically.

  "llamacpp_bin": "~/llama.cpp-turbo/build/bin/llama-server",

  "servers": {
    "dense": {
      "backend": "llamacpp",
      "model": "~/.cache/huggingface/hub/models--unsloth--Qwen3.6-27B-GGUF/snapshots/82d411acf4a06cfb8d9b073a5211bf410bfc29bf/Qwen3.6-27B-UD-Q6_K_XL.gguf",
      "port": 30080,
      "args": ["-c", "8192"]
    },
    // PARKED: model file is not on disk (Qwen3.6-35B-A3B UD-Q6_K_XL GGUF was
    // never downloaded here). Re-download or remove this entry before starting.
    "moe": {
      "backend": "llamacpp",
      "model": "~/.localllm/models/Qwen3.6-35B-A3B-UD-Q6_K_XL.gguf",
      "port": 30081,
      "args": ["-c", "8192"]
    },
    "mtp-vision": {
      "backend": "llamacpp",
      "model": "~/.cache/huggingface/hub/models--unsloth--Qwen3.8-27B-GGUF/snapshots/990216cf312573f2ac4060279848e0f4237600c7/Qwen3.8-27B-UD-Q4_K_XL.gguf",
      "mmproj": "~/.cache/huggingface/hub/models--unsloth--Qwen3.8-27B-GGUF/snapshots/990216cf312573f2ac4060279848e0f4237600c7/mmproj-F16.gguf",
      "port": 30082,
      // Sampling: official Qwen3.8 thinking-mode defaults (unsloth.ai/docs/models/qwen3.8)
      // repeat_penalty 1.0 and presence_penalty 0.0 already match llama.cpp defaults
      "args": [
        "-c", "262144",
        "--spec-type", "draft-mtp",
        "--spec-draft-n-max", "3",
        "--temp", "1.0",
        "--top-p", "0.95",
        "--top-k", "20",
        "--min-p", "0.0",
        // Qwen-VL needs >=1024 image tokens for correct grounding (llama.cpp load_hparams warning)
        "--image-min-tokens", "1024",
        "--chat-template-kwargs", "{\"reasoning_effort\":\"xhigh\",\"preserve_thinking\":true}"
      ]
    },
    // Qwen3.8-Flash-Next (qwen4exp arch): 125B MoE / 6B active + 51B n-gram PLE.
    // Current: UD-IQ4_XS ~93.7GB — fits Metal's working-set ceiling (115.4GB)
    // all-on-GPU, unlike UD-Q4_K_XL (111GB) which OOM'd at decode and needed
    // -ngl 36 (12 CPU layers → ~28 tok/s decode wall). IQ4_XS: 91.1% top-1
    // vs Q4_K_XL's 93.5%. Q4_K_XL files still on disk for rollback.
    // Context 128K (262K native; only 12 QSA layers grow KV).
    // Sampling: official Qwen3.8 thinking-mode defaults, same as mtp-vision.
    // draft-mtp: NOT on this vanilla binary yet ("speculative decoding not
    // supported by this context" 2026-08-28) — see flash-next-mtp below.
    "flash-next": {
      "backend": "llamacpp",
      "model": "~/.cache/huggingface/hub/models--unsloth--Qwen3.8-Flash-Next-GGUF/snapshots/c8b5954a88c2775c546b92593eda40ea041d3176/UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf",
      "mmproj": "~/.cache/huggingface/hub/models--unsloth--Qwen3.8-Flash-Next-GGUF/snapshots/c8b5954a88c2775c546b92593eda40ea041d3176/mmproj-F16.gguf",
      "port": 30085,
      "args": [
        // 1 x 262K full-context worker (current) — per-slot 40 tok/s solo.
        // Flip to -np 2 for 2 x 131K: measured 30 tok/s each, ~60 combined
        // (+50% throughput, less per-conversation ctx). Same KV cost (~6.4GB;
        // llama.cpp pre-allocates full -c at load, 24 KB/tok, slots don't change total).
        "-np", "1",
        // all layers on GPU (explicit — llama.cpp defaults to 0 without mmproj,
        // 99 with; don't rely on the silent default)
        "-ngl", "99",
        "-c", "262144",
        "--temp", "1.0",
        "--top-p", "0.95",
        "--top-k", "20",
        "--min-p", "0.0",
        "--image-min-tokens", "1024",
        "--chat-template-kwargs", "{\"reasoning_effort\":\"xhigh\",\"preserve_thinking\":true}"
      ]
    },
    // PLE SSD offload A/B twin of the profile above (--lazy-mode on-direct, PR #28136).
    // Same port ON PURPOSE: mutually exclusive with flash-next, serve's collision
    // guard enforces it. Use switch-flashserver.sh (switching kills the assistant).
    // "bin" is per-server — build-direct @ 905557969, NOT the global llamacpp_bin.
    // Same-binary control: temporarily drop the two offload flags below to see
    // --lazy-mode auto on this same commit. Rollback of the test = start flash-next.
    // KEEP IN SYNC: args mirror flash-next above, plus the offload flags.
    "flash-next-offload": {
      "backend": "llamacpp",
      "bin": "~/llama.cpp-turbo/build-direct/bin/llama-server",
      "model": "~/.cache/huggingface/hub/models--unsloth--Qwen3.8-Flash-Next-GGUF/snapshots/c8b5954a88c2775c546b92593eda40ea041d3176/UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf",
      "mmproj": "~/.cache/huggingface/hub/models--unsloth--Qwen3.8-Flash-Next-GGUF/snapshots/c8b5954a88c2775c546b92593eda40ea041d3176/mmproj-F16.gguf",
      "port": 30085,
      "args": [
        "-np", "1",
        "-ngl", "99",
        "-c", "262144",
        "--temp", "1.0",
        "--top-p", "0.95",
        "--top-k", "20",
        "--min-p", "0.0",
        "--image-min-tokens", "1024",
        "--chat-template-kwargs", "{\"reasoning_effort\":\"xhigh\",\"preserve_thinking\":true}",
        // --- offload trial flags (the whole point) ---
        "-lv", "4",
        "--lazy-mode", "on-direct"
      ]
    },
    // MTP trial (2026-09-04): experimental track = PR ggml-org/llama.cpp#28243
    // (danielhanchen, branch qwen4exp/mtp) built at ~/llama.cpp-mtp-src. Does
    // NOT include #28136 -> this one is lazy-mmap like vanilla flash-next.
    // Rollback = ./switch-flashserver.sh flash-next. Head: shared-Q8_0 2.6GB
    // (borrows embed+lm_head from main model; fit at startup prints ONE
    // borrow_shared_tensor error line then works - expected, -c/-ngl below are
    // explicit so the mis-measure cannot bite). Acceptance visible in log:
    // "draft acceptance = ...". n-max 2 LIVE per 2026-09-09 n0-n8 arm sweep
    // (real AVV-2200 sessions, ~25-40k ctx): marginal slot #2 clearly pays,
    // #3 breakeven, #4+ net-negative; means n2-n7 within noise (2207-2314
    // tok/min wall) but worst-request tg crosses vanilla at n5 and n8 is a
    // net LOSS (step time doubles). Floor: n2's worst request (34.0) is the
    // best of any arm. No on-direct here; if it OOMs
    // at load: head -> shared-Q4_K_M (1.8GB), then -c 131072.
    "flash-next-mtp": {
      "backend": "llamacpp",
      "bin": "~/llama.cpp-mtp-src/build-mtp/bin/llama-server",
      "model": "~/.cache/huggingface/hub/models--unsloth--Qwen3.8-Flash-Next-GGUF/snapshots/c8b5954a88c2775c546b92593eda40ea041d3176/UD-IQ4_XS/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf",
      "mmproj": "~/.cache/huggingface/hub/models--unsloth--Qwen3.8-Flash-Next-GGUF/snapshots/c8b5954a88c2775c546b92593eda40ea041d3176/mmproj-F16.gguf",
      "port": 30085,
      "args": [
        "-np", "1",
        "-ngl", "99",
        "-c", "262144",
        // NB: absolute path — serve does NOT expand ~ inside args (bin/model yes)
        "-md", "/Users/michael/localllm/mtp-heads/MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf",
        "--spec-type", "draft-mtp",
        // PRODUCTION A/B (2026-09-17): collecting real-episode data at n2.
        // n3 baselines SAFE: flash-next-mtp-nmax3-base-2026-09-16.log (24.2 t/s),
        // jgb-log-nmax3.log (25.1 t/s, 122h); 09-10 first-half = n2 production
        // (26.6, confounded day) — see episode_stats.py. BEFORE any restart that
        // rotates logs: mv flash-next-mtp.log flash-next-mtp-nmax2-<date>.log
        "--spec-draft-n-max", "2",
        "--temp", "1.0",
        "--top-p", "0.95",
        "--top-k", "20",
        "--min-p", "0.0",
        "--image-min-tokens", "1024",
        "--chat-template-kwargs", "{\"reasoning_effort\":\"xhigh\",\"preserve_thinking\":true}",
        "-lv", "4"
      ]
    },
    // GLM-5.3-Flash UD-IQ3_XXS (Z.ai "ox-alpha"): 321B MoE / 18B active, arch
    // glm5next — hybrid MLA+sparse-indexer (only ~12 of 46 layers are full
    // attention, rest linear/KDA) + 288-expert MoE; native 1M ctx; thinking
    // template takes reasoning_effort low|high|max (default max). 120.4GB
    // weights on a 128GB box: ALL-GPU IS IMPOSSIBLE (weights alone exceed the
    // ~115.4GB Metal working-set ceiling we measured on flash-next) — this
    // entry leans on llama.cpp memory auto-fit (-fit on) to pick the GPU/CPU
    // layer split + KV budget from free memory at boot.
    // NO OTHER BINARY CAN OPEN THIS FILE: glm5next exists only in unsloth's
    // PR ggml-org/llama.cpp#27754 branch. Built at ~/llama.cpp-glm5
    // (branch glm5next/upstream @ d94f44e, 2026-09-11). CPU-only load
    // (mmap, -ngl 0) verified healthy; Metal ladder = probe-glm53.sh.
    // Sampling: unsloth recommended (temp 1.0, top_p 0.95; matches GGUF
    // general.sampling.* metadata).
    // MTP ready but OFF until ctx sizing is settled: this branch has
    // --spec-type draft-mtp with the nextn layer EMBEDDED in the GGUF
    // (no -md file, unlike flash-next-mtp) — unsloth claims 3.3x at long
    // ctx, n-max 2 (their table + our flash-next sweep agree).
    // Mutually exclusive with every big-llama entry (memory, not ports).
    "glm53": {
      "backend": "llamacpp",
      "bin": "~/llama.cpp-glm5/build/bin/llama-server",
      "model": "~/.cache/huggingface/hub/models--unsloth--GLM-5.3-Flash-GGUF/snapshots/621d456e93e926e4b52f85cff5f634358c1828f9/UD-IQ3_XXS/GLM-5.3-Flash-UD-IQ3_XXS-00001-of-00004.gguf",
      "port": 30086,
      "args": [
        // CANDIDATE config pending probe-glm53.sh r2 confirmation. r1 lesson:
        // --fit on MIS-ESTIMATES this arch (glm5next PR branch): estimated
        // 108.2G used but needed 114.1G vs the 110.1G MTL0 budget -> decode
        // OOM. So: fit OFF, all layers on GPU EXCEPT the first N layers' MoE
        // experts (--n-cpu-moe, ~2.4G/layer moved to pageable CPU RAM),
        // single slot, 1 checkpoint/slot, 1G prompt cache (defaults: 32/8G).
        // NOTE: -fitp (--fit-print) does not exist in llama-server (only in
        // the llama-fit-params tool). Never start glm53 while another big
        // model (flash-next*/mtp-vision) holds memory. On r2 PASS, pin the
        // verified ncmoe/ctx pair here.
        "--fit", "off",
        "-ngl", "99",
        "--n-cpu-moe", "6",
        "-np", "1",
        "--ctx-checkpoints", "1",
        "--cache-ram", "1024",
        "-c", "32768",
        "--temp", "1.0",
        "--top-p", "0.95",
        "--chat-template-kwargs", "{\"reasoning_effort\":\"max\"}"
      ]
    },
    // MLX FLASH-NEXT — DAILY DRIVER (2026-09-17). Engine: mlx-serve (ddalcu/mlx-serve,
    // Zig binary; versioned install pinned at serve:MLXSERVE_BIN, NOT the brew tap and
    // NOT the mlx-lm-turbo fork (mlx-* entries below)).
    // Model: Qwen3.8-Flash-Next mixed-4-8bit, 100GB on disk = 70.13GB weights +
    // 32GB ngram PLE (serial-mmap warm, never wired — the "100GB" never bites).
    // 512K ctx (YaRN factor 2.0 over native 262K): full 1M fills OOM at ~105.6GB
    // active (physical RAM wall even with iogpu.wired_limit_mb=120000, kIOGPU
    // error; measured 2026-09-17). Measured: prefill ~990-1030 t/s, decode
    // ~47-50 small ctx / 20.6 @687K. Sampling = Qwen thinking defaults; MTP
    // forced via --mtp (MoE target needs the flag). KV 8-bit, SSD prefix tier.
    // Mutually exclusive with llama entries on :30085 (serve collision guard).
    // opencode provider "mlx-flash/qwen3.8-flash-next-mlx" + jgb-bot MODEL point
    // here. Rollback to llama: ./serve stop mlx-flash && ./serve start flash-next-mtp.
    "mlx-flash": {
      "backend": "mlxserve",
      "model": "~/.localllm/models/Qwen3.8-Flash-Next-MLX-Serve-mixed-4-8bit",
      "port": 30085,
      "args": [
        // Admission refused prefill with the DEFAULT --os-reserve-gib (8, the
        // 2-8 clamp of 128/8): 2026-11-04 logged 28 `prefill refused` at
        // needed=9233-11196MB against available=4677-6500MB while glm-sushi ran
        // this flag at 0 and mlx-flash did not. 0 = free RAM is planable again;
        // the risk the flag's own help names is a freeze under heavy load, and
        // phys_footprint_peak 114 GB says we have already been there.
        "--os-reserve-gib", "0",
        // HTTP mode is NOT mlx-serve's default (interactive chat is) — explicit.
        "--serve",
        "--ctx-size", "524288",
        "--kv-quant", "8",
        // TAKING THE 26.11.x DEFAULT (0.25) as of 2026-11-12. We pinned 0 to escape the
        // 26.11.1 refusal regime (0 hard failures in 2,091 requests on 26.10.x vs 30 in
        // 1,964 on 26.11.1), but the cause was #1091, not the schedule: N rows of stacked
        // logits leaked per batched decode token "for as long as two or more streams
        // decoded together", and #1071 (same model, same 128 GB box) measured ~21 GB
        // surviving unload. That is why two sessions going felt like the trigger — batched
        // decode IS the leak path — and why the floor rose while billed per-session bytes
        // did not (20.85 vs 20.61 KB/token). The fix shipped in v26.11.2, which we have run
        // since 2026-11-11 14:46, so the new default was never assessable until now — and
        // staying on the old schedule is not free either: at 0 a long prefill starves every
        // decoding stream outright, which is the felt cost of the 512K pool law (the train
        // prefills 400k and the interactive session stops dead).
        // COST, stated honestly: the flag's own help says it "also narrows that prefill's
        // chunks", and prefill on this model is chunk-sensitive (upstream: 4096 -> 1071,
        // 2048 -> 1029 tok/s; MoE gather 28.3 TFLOP/s at 4096 vs 14.2 at 1024). And
        // `--prefill-chunk` is a CEILING, not a floor, so this flag is its own only off
        // switch. Note also that the 26.11.1 `width=512` lines were admission-planner
        // PROBES (8192->4096->2048->1024->512, printing the narrowest), not executed chunk
        // sizes — they proved plan pressure, not striding. MLX_SERVE_PREFILL_TRACE does not
        // survive in 26.11.2, so the observable is the counter-derived cold rate.
        // PASS (keep it): requests_rejected_total stays 0; the hourly floor of
        // mlx_active_bytes is flat WITH batched-decode exposure over ~20k tokens
        // (`python3 tools/mem-watch.py --report`); aggregate cold prefill stays within
        // ~15% of the 1,953 t/s measured on 26.11.2 at share 0. FAIL: put back
        // "--prefill-decode-share", "0" — which also removes the leak exposure, so a
        // ratcheting floor under 0.25 is an upstream report, not just a revert.
        // NOT set, on purpose: `--no-prefix-cache-ram` (drop idle prefixes from
        // RAM). Idle RAM retention is what we have always run and want to keep.
        // Measured across all 30 hard failures on 26.11.1 (26.10.x: zero): the
        // evict-to-admit pass ran only 7 times and 29 of the 30 failures never
        // reached it at all, and where a truly idle live entry existed it handed
        // back 1.6-7.0 GB and the prefill proceeded. So cache retention was never
        // the byte the gate needed — `pinned == resident` in all 30, i.e. the held
        // RAM is always the caller's own KV, which the gate is right not to take
        // (dropping it turns a 1.5 s restore into a ~4 min cold prefill). The
        // failures are a 139-3888 MB plan shortfall, so the levers are the plan
        // ceiling (the two flags above) and the prompt's own size, not
        // `--prefix-cache-mem` / `--prefix-cache-entries`. The one suspicious line
        // — `evicted 1 entries (0 MB live, 5920 MB billed)` — is an entry whose KV
        // had already moved into a live slot, seen once; if it ever shows up twice
        // more AND the footprint does not fall after it, that is an upstream report.
        "--mtp",
        // Depth is left at the engine default (adaptive, ceiling 6 on this silicon).
        // A cap of 4 was armed 2026-11-11 on the strength of a MISREAD counter: in
        // `[spec-stats]`, `avg_per_round` = accepts/attempts counts accepted DRAFT
        // tokens only — the round also commits one token — so the correct cost is
        // round_ms/(1+avg_per_round). With the right denominator MTP pays **1.49x**
        // here (67.8 vs 45.6 t/s across 4,342 rounds), not the 0.93x the first
        // reading gave, and the planner already chooses ~3.2 rows/round on its own,
        // so a ceiling of 4 only clips it (realised width fell to 2.5). Do not lower
        // it again without re-running tools/mtp-yield.py — it now self-checks the
        // round math against the engine's per-request `decode:` rate and says so.
        "--metrics",
        "--temp", "1.0",
        "--top-p", "0.95",
        "--top-k", "20",
        // Sized to the measured working set (~48 prefixes/day, 1.22 GB/entry):
        // 200 GB ≈ 2.5 days. 10 GB held ~8 entries and thrashed; the cap is the
        // eviction control, so keep it well under free space (min 64 GiB reserve).
        "--prefix-cache-disk", "200GB",
        // On SIGTERM, finish writing KV slices that are still only in RAM. ./serve
        // gives mlxserve stops 50s for exactly this (serve do_stop); 0 disables.
        "--shutdown-persist-secs", "45",
        // YaRN long-context override (native max_position_embeddings is 262144).
        "--config-overrides", "{\"text_config\":{\"rope_parameters\":{\"rope_type\":\"yarn\",\"factor\":2.0,\"original_max_position_embeddings\":262144},\"max_position_embeddings\":524288}}"
      ]
    },
    // MLX FLASH-NEXT @1M — bigmac's daily (added 2026-11-25). Same model, same
    // flags as mlx-flash; ONE difference: --ctx-size 1048576 with YaRN factor 4.0
    // over the native 262144. Why this box carries it and the MacBook cannot: the
    // 1M OOM that closed the question on 2026-09-17 (~105.6GB active, physical
    // wall, kIOGPU error) was measured on 128 GB. bigmac is a 512 GB M5 Ultra,
    // where 1M Q8 KV is ~18GB above ~75GB of resident weights — a fit, not a
    // reach. Same silicon class as the Reddit M5-Ultra benchmark thread
    // (wiki: m5-ultra-benchmark-reddit-2026-11-18), whose top Flash-Next rows ran
    // YaRN x4 and filled 1M at 93.2 t/s.
    // ENGINE: bigmac has only 26.11.2 on disk, so the pin travels by env in that
    // box's ~/.zprofile —
    //   MLXSERVE_BIN=~/.localllm/mlx-serve-26.11.2/mlx-serve-macos-arm64/mlx-serve
    // Do NOT raise serve's default: 26.10.2 is lilmac's leak rollback and it is
    // running it today. Prefill-decode-share takes the 26.11.x default (0.25) for
    // the reasons argued under mlx-flash; MTP stays at engine defaults (see the
    // 1.49x verdict there — do not re-arm a depth cap).
    // Shares :30085 with mlx-flash, so the collision guard keeps them apart — but
    // only by pidfile, so a server started outside ./serve is invisible to it.
    // Never run both.
    "mlx-flash-big": {
      "backend": "mlxserve",
      "model": "~/.localllm/models/Qwen3.8-Flash-Next-MLX-Serve-mixed-4-8bit",
      "port": 30085,
      "args": [
        "--os-reserve-gib", "0",
        "--serve",
        "--ctx-size", "1048576",
        "--kv-quant", "8",
        "--mtp",
        "--metrics",
        "--temp", "1.0",
        "--top-p", "0.95",
        "--top-k", "20",
        // 3.4 TiB free on this volume; the 64 GiB reserve the disk-tier note asks
        // for is not a constraint here. Raised 200GB -> 500GB 2026-11-25: at
        // ~48 prefixes/day x 1.22 GB the cap was ~2.5 days of retention on
        // lilmac; 500 GB is ~10 days, and 1 TB pays for nothing until the cache
        // actually grows past 200 GB.
        "--prefix-cache-disk", "500GB",
        "--shutdown-persist-secs", "45",
        // YaRN long-context override (native max_position_embeddings is 262144).
        "--config-overrides", "{\"text_config\":{\"rope_parameters\":{\"rope_type\":\"yarn\",\"factor\":4.0,\"original_max_position_embeddings\":262144},\"max_position_embeddings\":1048576}}"
      ]
    },
    // DeepSeek-V4.1-Flash-1017 "Lossless" (ddalcu; arch deepseek_v41 — bit-exact
    // repack of the release: MXFP4 routed experts, FP8 trunk, dense bf16
    // head/wo_a; 3 MTP draft stages + markov/confidence heads and the vision tower
    // ride along; 1M native, YaRN x16 already in config.json, so NO
    // --config-overrides here). 477 GiB on disk = 288 GB resident + 189 GiB of
    // Engram n-gram tables in engram/, which the engine reads from SSD per token
    // and never wires. It must stay on the internal drive: the pack author
    // measured Engram on an external disk at ~27% slower prefill.
    // EXPECTATION, same silicon + same engine version, measured by someone else:
    // wiki [[m5-ultra-benchmark-reddit-2026-11-18]] Index 33 — 58.3 t/s @4K ->
    // 55.3 @1M, prefill 2,852 -> 1,643 t/s, peak wired 299.7 GiB @4K -> 328.4 @1M,
    // all at engine defaults. ddalcu have never loaded this pack on a 512 GB
    // machine themselves, so our first boot is the test of the ceiling claim.
    // MEMORY-EXCLUSIVE with every other big entry, mlx-flash-big above all: 288 GB
    // of weights plus the ~75 GB flash-big holds crosses the ~384 GiB Metal wired
    // pool, and the pool is a wall no --os-reserve-gib moves. Its port (30088) is
    // unique, so serve's collision guard does NOT keep them apart —
    // ./serve stop mlx-flash-big FIRST.
    // NOT set, deliberately, so the first arm stays comparable to that row:
    // --kv-quant (this is the reference pack; 8-bit KV is the lever if a second
    // 1M session is wanted), --prefix-cache-disk (lever #1 if agentic re-prefill
    // hurts — Engram's own demand is ~2 KB/token, so the only contention is KV
    // restore), --os-reserve-gib 0 (that flag exists because the 128 GB box could
    // not admit its own prefill; here the default 8 GB is affordable headroom).
    // Speculative decode stays at engine defaults: V4.1 auto-runs the draft stages
    // the pack ships unless --no-mtp; --dspark is the embedded ds4 runtime for
    // .gguf inputs and does nothing to a safetensors pack.
    // Sampling: the 1017 card's recommendation (temp 1.0, top_p 0.95 — the card
    // also allows 1.0). Note these are mostly inert in DeepSeek's thinking mode:
    // temperature is accepted and ignored, top_p is floored at 0.95. Thinking is
    // ON by default at effort "high"; effort is a per-request reasoning_effort
    // field (low|high|max, or 1-100) — there is no server-side flag for it.
    "mlx-deepseek": {
      "backend": "mlxserve",
      "model": "~/.localllm/models/DeepSeek-V4.1-Flash-1017-MLX-Serve-Lossless",
      "port": 30088,
      "args": [
        // HTTP mode is NOT mlx-serve's default (interactive chat is).
        "--serve",
        // 1M is the pack's own window; naming it keeps the opencode limits honest.
        "--ctx-size", "1048576",
        "--temp", "1.0",
        "--top-p", "0.95",
        "--metrics"
      ]
    },
    // glm-sushi: GLM-5.3-Flash Sushi-2.4bpw (EXL3, 97.8 GB pack) on STOCK
    // mlx-serve (binary pinned in ./serve — 26.11.1 since 2026-11-03). 26.10.2 was
    // the first release where "Sushi's GLM-5.3, MiMo and BF16 Flash Next packs load
    // as they are" (GLM-5.3 vision, DFlash2 drafting, image conversations
    // capture+restore on the SSD tier); 26.10.3 added "GLM-5.3 answers as it should
    // when several chats share it or it drafts ahead". Still unreleased in either:
    // upstream #1046, a GLM turn with no reasoning inheriting the previous turn's
    // reasoning_content from a shared jinja {% for %} scope. Previously ran on
    // the beamivalice/sushi fork (now installed but no longer the loader);
    // ROLLBACK = flip `backend` back to "sushi" and ./serve restart. Distinct
    // port so the collision guard refuses to run it beside mlx-flash: the
    // exclusion is by MEMORY (GLM 2.4bpw wants ~96.5 GiB at 512K ctx per
    // Sushi's table, flash-next holds ~83 GiB wired — the sum is over
    // physical), not by ports.
    // ctx 524288 stays inside the AUTO gpu pool (110,100 MiB); Sushi's documented
    // 1M for this pack assumes `sudo sysctl iogpu.wired_limit_mb=120000` (resets at
    // reboot). GLM native ctx is 1M — no YaRN override. Drafting = the pack's
    // DFlash2 assistant, auto-detected (drafter priority MTP > dflash > drafter;
    // --no-mtp only kills the native MTP head — GLM has none, DFlash2 stays on;
    // --no-drafter / --no-vision are the opt-outs, neither passed). opencode
    // provider "sushi-glm" (name kept — the pack is still the Sushi pack).
    "glm-sushi": {
      "backend": "mlxserve",
      "model": "~/.sushi/models/beamster/GLM-5.3-Flash-Sushi-2.4bpw",
      "port": 30087,
      "args": [
        "--serve",
        "--ctx-size", "524288",
        "--kv-quant", "8",
        "--no-mtp",
        // Admission refused prefill with the DEFAULT --os-reserve-gib (8, the
        // 2-8 clamp of 128/8): needed=14022MB available=7733MB on a dedicated
        // single-model box. 0 = no OS reserve: 15.7GB available ≥ 14.0GB
        // needed (prefill width already at the model's auto-cap 512; resident
        // 91.7 GiB + working ~13 GiB still inside the 107.5 GiB pool).
        "--os-reserve-gib", "0",
        // DFlash2 is NOT auto-discovered here: stock mlx-serve only auto-loads a
        // checkpoint-shipped drafter from a subdir named drafter/ — the Sushi
        // pack ships dflash2/ (its fork auto-detects that; stock does not), so
        // without this flag we silently fall back to PLD (measured: "PLD
        // speculative decoding: ENABLED"). sushi's own log line was
        // "[dflash] auto-detected assistant: …/dflash2" — the fork knew.
        "--drafter", "/Users/michael/.sushi/models/beamster/GLM-5.3-Flash-Sushi-2.4bpw/dflash2",
        "--shutdown-persist-secs", "45",
        "--metrics",
        "--temp", "1.0",
        "--top-p", "0.95",
        "--top-k", "20",
        "--prefix-cache-disk", "200GB"
      ]
    },
    "qwen27b-bf16-mtp": {
      "backend": "mlxserve",
      "model": "~/.localllm/models/Qwen3.8-27B-bf16-MTP-MLX",
      "port": 30100,
      "args": [
        "--serve",
        "--ctx-size", "262144",
        "--kv-quant", "off",
        "--mtp",
        "--metrics",
        "--temp", "1.0",
        "--top-p", "0.95",
        "--top-k", "20",
        "--prefix-cache-disk", "200GB",
        "--shutdown-persist-secs", "45"
      ]
    },
    "mlx-dense": {
      "backend": "mlx",
      "model": "~/.localllm/models/Qwen3.6-27B-UD-MLX-4bit",
      "port": 30090,
      "args": [
        "--prompt-cache-size", "50",
        "--decode-concurrency", "2",
        "--prompt-concurrency", "2",
        "--prefill-step-size", "2048",
        "--temp", "0.6",
        "--max-tokens", "32768",
        //"--turbo-kv-bits", "3",
        "--top-p", "0.95",
        "--top-k", "20",
        "--prompt-cache-bytes", "21474836480",
        "--prompt-cache-dir", "/Users/michael/.localllm/prompt_cache"
      ]
    },
    "mlx-moe-8bit": {
      "backend": "mlx",
      "model": "~/.cache/huggingface/hub/models--unsloth--Qwen3.6-35B-A3B-MLX-8bit/snapshots/d928611c119d7d86037d6926ac50712062ff0f29",
      "port": 30084,
      "args": [
        "--prompt-cache-size", "50",
        "--decode-concurrency", "4",
        "--prompt-concurrency", "4",
        "--prefill-step-size", "2048",
        "--temp", "0.6",
        "--max-tokens", "32768",
        "--top-p", "0.95",
        "--top-k", "20",
        "--prompt-cache-bytes", "21474836480",
        //"--turbo-kv-bits", "3",
        //"--kv-cache-quantization", "8,4",
        //"--quantized-kv-start", "0",
        "--prompt-cache-dir", "/Users/michael/.localllm/prompt_cache"
      ]
    },
    "mlx-moe": {
      "backend": "mlx",
      "model": "~/.localllm/models/Qwen3.6-35B-A3B-UD-MLX-4bit",
      "port": 30083,
      "args": [
        "--prompt-cache-size", "50",
        "--decode-concurrency", "4",
        "--prompt-concurrency", "4",
        "--prefill-step-size", "2048",
        "--temp", "0.6",
        "--max-tokens", "32768",
        "--top-p", "0.95",
        "--top-k", "20",
        "--prompt-cache-bytes", "21474836480",
        "--kv-cache-quantization", "8,4",
        "--quantized-kv-start", "0",
        "--prompt-cache-dir", "/Users/michael/.localllm/prompt_cache"
      ]
    },
    // PARKED: optiq/MLX+MTP experiment (model is an HF repo id that optiq
    // resolves at start; the 2026-06-09 download was left incomplete, see
    // ~/.localllm/optiq-download.log).
    "mlx-dense-mtp": {
      "backend": "optiq",
      "model": "mlx-community/Qwen3.6-27B-OptiQ-4bit",
      "port": 30091,
      "args": [
        "--mtp",
        "--mtp-depth", "2",
        "--temp", "0.8",
        "--max-tokens", "32768",
        "--top-p", "0.95",
        "--top-k", "40",
        "--min-p", "0.05"
      ]
    }
  }
}
