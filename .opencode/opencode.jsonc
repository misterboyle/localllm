{
  "$schema": "https://opencode.ai/config.json",
  // Project-specific overrides only.
  // Providers live in ~/.config/opencode/opencode.jsonc — don't duplicate them here.

  "skills": {
    "paths": [".opencode/skills"]
  },
  "agent": {
    "memory-monitor": {
      "file": ".opencode/agent/memory-monitor.md"
    }
  },
  "command": {
    "benchmark": {
      "template": ".opencode/command/benchmark.md"
    },
    "characterize": {
      "template": ".opencode/command/characterize.md"
    },
    "compare": {
      "template": ".opencode/command/compare.md"
    }
  },
  "compaction": {
    "auto": false,
    "prune": false
  }
}
