// opencode.jsonc example — MLX server providers
// Copy to ~/.config/opencode/opencode.jsonc and edit as needed
//
// The MLX servers themselves are defined in ~/localllm/servers.jsonc
// (mlx-* entries). This file only adds opencode providers pointing at them.
// Only needed when the parked MLX layer is running — the production
// mtp-vision server (llama.cpp, port 30082) is configured separately.
// Ports: mlx-dense=30090, mlx-moe=30083, mlx-dense-mtp=30091
//
// NOTE: MLX model `name` key must be the full local path. The MLX server
// re-resolves the model from each request, so the key must match the path
// loaded at startup. (The `name` field inside is just display text.)

{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    // --- MLX servers ---
    "mlx-dense": {
      "name": "MLX Qwen3.6-27B Dense",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:30090/v1",
        "apiKey": "sk-local"
      },
      "models": {
        // Key must be full local path — MLX server re-resolves from request.
        // Absolute path, NOT $HOME/... — opencode does not expand it.
        "/Users/michael/.localllm/models/Qwen3.6-27B-UD-MLX-4bit": {
          "name": "Qwen3.6-27B-UD-MLX-4bit",
          "maxTokens": 262144,
          "limit": {
            "context": 262144,
            "output": 8192
          }
        }
      }
    },
    "mlx-moe": {
      "name": "MLX Qwen3.6-35B-A3B MoE",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:30083/v1",
        "apiKey": "sk-local"
      },
      "models": {
        // Key must be full local path — MLX server re-resolves from request.
        // Absolute path, NOT $HOME/... — opencode does not expand it.
        "/Users/michael/.localllm/models/Qwen3.6-35B-A3B-UD-MLX-4bit": {
          "name": "Qwen3.6-35B-A3B-UD-MLX-4bit",
          "maxTokens": 262144,
          "limit": {
            "context": 262144,
            "output": 8192
          }
        }
      }
    }
  },

  // Default model — change to any provider/model combo above.
  // Model IDs here are full paths starting with "/", so the separator makes
  // TWO slashes (provider//path) — exactly like the live config. THREE is a
  // bug: TUI tolerates it, `opencode run` dies with ProviderModelNotFoundError.
  "model": "mlx-moe//Users/michael/.localllm/models/Qwen3.6-35B-A3B-UD-MLX-4bit",

  // Unsloth Qwen3.6 thinking mode (general): temp=1.0, top_p=0.95
  // Coding mode uses temp=0.6 (can be overridden per-agent if needed)
  "agent": {
    "temperature": 1.0,
    "top_p": 0.95
  },

  "compaction": {
    "auto": false,
    "prune": false
  }
}
