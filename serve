#!/usr/bin/env bash
set -euo pipefail

CONF="$(cd "$(dirname "$0")" && pwd)/servers.jsonc"
PID_DIR="$(cd "$(dirname "$0")" && pwd)/pids"
LOG_DIR="$(cd "$(dirname "$0")" && pwd)"
mkdir -p "$PID_DIR"

# Strip JSONC comments → valid JSON
json() {
  python3 -c "
import re, sys, json
raw = sys.stdin.read()
raw = re.sub(r'//.*?$', '', raw, flags=re.MULTILINE)
raw = re.sub(r'/\*.*?\*/', '', raw, flags=re.DOTALL)
json.dump(json.loads(raw), sys.stdout)
"
}

# Expand leading ~ in paths
expand_path() {
  echo "${1/#\~/$HOME}"
}

# Get llama.cpp binary path (always absolute)
llamacpp_bin() {
  local default_bin
  default_bin="$(cd "$(dirname "$0")" && pwd)/build/bin/llama-server"
  local bin
  bin=$(cat "$CONF" | json | python3 -c "import json,sys,os; print(os.path.expanduser(json.load(sys.stdin).get('llamacpp_bin','$default_bin')))")
  # Resolve relative paths against script directory
  if [[ "$bin" != /* ]]; then
    bin="$(cd "$(dirname "$0")" && pwd)/$bin"
  fi
  echo "$bin"
}

# List all server names
list_servers() {
  cat "$CONF" | json | python3 -c "import json,sys; [print(n) for n in json.load(sys.stdin)['servers']]"
}

# Get a field from a server entry
server_field() {
  local name="$1" field="$2"
  cat "$CONF" | json | python3 -c "
import json,sys
cfg = json.load(sys.stdin)
val = cfg['servers']['$name'].get('$field', '')
print(val if val else '')
"
}

# Get args as space-separated string (shlex-quoted: values may contain
# quotes/spaces, e.g. --chat-template-kwargs JSON — see AGENTS.md)
server_args() {
  local name="$1"
  cat "$CONF" | json | python3 -c "
import json,sys,shlex
args = json.load(sys.stdin)['servers']['$name'].get('args', [])
print(' '.join(shlex.quote(a) for a in args))
"
}

# Build llama.cpp command line
build_llamacpp_cmd() {
  local name="$1"
  local model mmproj port args

  model=$(expand_path "$(server_field "$name" model)")
  mmproj=$(expand_path "$(server_field "$name" mmproj)")
  port=$(server_field "$name" port)
  args=$(server_args "$name")

  # per-server "bin" overrides global llamacpp_bin (e.g. flash-next-offload -> build-direct)
  local bin
  bin=$(server_field "$name" bin)
  if [ -n "$bin" ]; then
    bin=$(expand_path "$bin")
    if [[ "$bin" != /* ]]; then
      bin="$(cd "$(dirname "$0")" && pwd)/$bin"
    fi
  else
    bin=$(llamacpp_bin)
  fi

  local cmd="$bin -m '$model' --port $port --host 127.0.0.1 $args"

  if [ -n "$mmproj" ]; then
    cmd="$cmd --mmproj '$(expand_path "$mmproj")'"
  fi

  echo "$cmd"
}

# MLX turbo venv — used for mlx-lm backends
MLX_TURBO_VENV="${HOME}/mlx-lm-turbo/venv"

# OptIQ venv — used for optiq serve backends (with MTP support)
OPTIQ_VENV="${HOME}/.localllm/venvs/optiq"

# mlx-serve (ddalcu/mlx-serve, Zig engine) — NOT the mlx-lm-turbo fork;
# different CLI (see servers.jsonc "mlx-flash" entry).
# 26.10.2 installed versioned 2026-10-12 (first release with Sushi GLM-5.3/
# MiMo/BF16 Flash Next EXL3 packs, GLM-5.3 vision, image conversations on the
# SSD tier, and DFlash2 drafting for GLM-5.3 — the glm-sushi entry now runs on
# this binary, not the sushi fork). 26.10.1 was the #573 SSD prefix-cache
# accounting fix. Rollback: point MLXSERVE_BIN back at
# ~/.localllm/mlx-serve-26.10.1/mlx-serve (or 26.9.5).
# The brew tap formula is older still (26.9.2) — not a rollback target.
MLXSERVE_BIN="${HOME}/.localllm/mlx-serve-26.10.2/mlx-serve-macos-arm64/mlx-serve"

# sushi (beamivalice/sushi, brew install beamivalice/tap/sushi) — the only engine
# that loads Sushi EXL3 packs (GLM-5.3-Flash 2.4bpw). /opt/homebrew/bin so the
# brew-managed binary upgrades itself without moving this launcher's target.
SUSHI_BIN="${SUSHI_BIN:-/opt/homebrew/bin/sushi}"

# Build mlx-serve command line
build_mlxserve_cmd() {
  local name="$1"
  local model port args

  model=$(expand_path "$(server_field "$name" model)")
  port=$(server_field "$name" port)
  args=$(server_args "$name")

  # --host pinned loopback on purpose: mlx-serve defaults to 0.0.0.0 (LAN open)
  # and this box has a standing rule against exposing servers (2026-09-13).
  echo "$MLXSERVE_BIN --model '$model' --port $port --host 127.0.0.1 $args"
}

# Build sushi command line (beamivalice/sushi — detached mlx-serve fork, same CLI
# shape; its GLM/MiMo EXL3 packs do not load in stock mlx-serve). Loopback pinned
# for the same 2026-09-13 rule as above.
build_sushi_cmd() {
  local name="$1"
  local model port args

  model=$(expand_path "$(server_field "$name" model)")
  port=$(server_field "$name" port)
  args=$(server_args "$name")

  echo "$SUSHI_BIN --model '$model' --port $port --host 127.0.0.1 $args"
}

# Build mlx command line
build_mlx_cmd() {
  local name="$1"
  local model port args

  model=$(expand_path "$(server_field "$name" model)")
  port=$(server_field "$name" port)
  args=$(server_args "$name")

  echo "${MLX_TURBO_VENV}/bin/python3 -m mlx_lm.server --model '$model' --port $port --host 127.0.0.1 $args"
}

# Build optiq command line
build_optiq_cmd() {
  local name="$1"
  local model port args

  model=$(expand_path "$(server_field "$name" model)")
  port=$(server_field "$name" port)
  args=$(server_args "$name")

  # optiq serve passes extra args through to mlx_lm.server
  echo "${OPTIQ_VENV}/bin/optiq serve --model '$model' --port $port --host 127.0.0.1 $args"
}

# Start all servers (or specific ones)
do_start() {
  local targets=("$@")

  if [ ${#targets[@]} -eq 0 ]; then
    targets=()
    local srv
    while IFS= read -r srv; do
      targets+=("$srv")
    done < <(list_servers)
  fi

  for name in "${targets[@]}"; do
    local backend model port logf pidfile

    backend=$(server_field "$name" backend)
    port=$(server_field "$name" port)
    logf="$LOG_DIR/${name}.log"
    pidfile="$PID_DIR/${name}.pid"

    # Check if already running
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
      echo "$name already running on port $port (PID $(cat "$pidfile"))"
      continue
    fi

    # Port collision: a DIFFERENT server is live on this port. Same-port profiles
    # (e.g. flash-next / flash-next-offload) are mutually exclusive — 128 GB-class
    # models leave zero RAM headroom for doubles (2026-09-01 incident).
    if [ "${FORCE:-0}" != "1" ]; then
      local other s_pidfile
      for other in $(list_servers); do
        [ "$other" = "$name" ] && continue
        [ "$(server_field "$other" port)" = "$port" ] || continue
        s_pidfile="$PID_DIR/${other}.pid"
        if [ -f "$s_pidfile" ] && kill -0 "$(cat "$s_pidfile")" 2>/dev/null; then
          echo "REFUSED: $other is running on port $port (PID $(cat "$s_pidfile"))."
          echo "  Stop it first: ./serve stop $other   (or FORCE=1 to override)"
          exit 1
        fi
      done
    fi

    echo "Starting $name on port $port ($backend)..."

    local cmd
    if [ "$backend" = "mlx" ]; then
      cmd=$(build_mlx_cmd "$name")
    elif [ "$backend" = "optiq" ]; then
      cmd=$(build_optiq_cmd "$name")
    elif [ "$backend" = "mlxserve" ]; then
      cmd=$(build_mlxserve_cmd "$name")
    elif [ "$backend" = "sushi" ]; then
      cmd=$(build_sushi_cmd "$name")
    else
      cmd=$(build_llamacpp_cmd "$name")
    fi

    # Rotate: each server start begins a fresh log; keep one archive (2026-09-04:
    # spec-decode error spam grew one session's log to 2 MB / 27k lines).
    if [ -f "$logf" ] && [ -s "$logf" ]; then
      mv -f "$logf" "${logf}.1"
    fi

    echo "$cmd" >> "$logf" 2>&1
    eval "exec $cmd" >> "$logf" 2>&1 &
    echo $! > "$pidfile"

    echo "  → PID $!"
  done

  echo ""
  echo "Waiting for servers to be ready (polling /health, up to ~60s)..."
  sleep 3

  # Poll instead of the old single probe: 100 GB-class loads (llama.cpp AND
  # mlx-serve) routinely outlast a fixed 3s wait and false-alarmed ✗ on a
  # healthy boot. Now: first check after 3s, then every 5s up to ~60s.
  for name in "${targets[@]}"; do
    local port tries
    port=$(server_field "$name" port)
    tries=0
    while ! curl -sf "http://localhost:$port/health" > /dev/null 2>&1; do
      tries=$((tries + 1))
      if [ "$tries" -ge 12 ]; then
        echo "  ✗ $name (localhost:$port) — not healthy after ~60s; check $LOG_DIR/${name}.log"
        continue 2
      fi
      sleep 5
    done
    echo "  ✓ $name (localhost:$port)"
  done
}

# Stop all servers (or specific ones)
do_stop() {
  local targets=("$@")

  if [ ${#targets[@]} -eq 0 ]; then
    targets=()
    local srv
    while IFS= read -r srv; do
      targets+=("$srv")
    done < <(list_servers)
  fi

  for name in "${targets[@]}"; do
    local pidfile="$PID_DIR/${name}.pid"
    local pid

    if [ ! -f "$pidfile" ]; then
      echo "$name not running (no PID file)"
      continue
    fi

    pid="$(cat "$pidfile")"

    if ! kill -0 "$pid" 2>/dev/null; then
      echo "$name not running (stale PID $pid)"
      rm -f "$pidfile"
      continue
    fi

    # SIGTERM first, give it 2 seconds to shut down cleanly
    kill "$pid" 2>/dev/null
    local waited=0
    while [ $waited -lt 2 ] && kill -0 "$pid" 2>/dev/null; do
      sleep 1
      waited=$((waited + 1))
    done

    # If still alive, SIGKILL
    if kill -0 "$pid" 2>/dev/null; then
      echo -n "  $name didn't stop, sending SIGKILL..."
      kill -9 "$pid" 2>/dev/null
      sleep 0.5
      if kill -0 "$pid" 2>/dev/null; then
        echo " FAILED — use 'kill -9 $pid' manually"
      else
        echo " done"
      fi
    fi

    rm -f "$pidfile"
    echo "Stopped $name"
  done
}

# Show status of all servers (or specific ones)
do_status() {
  local targets=("$@")

  if [ ${#targets[@]} -eq 0 ]; then
    targets=()
    local srv
    while IFS= read -r srv; do
      targets+=("$srv")
    done < <(list_servers)
  fi

  echo "Server status:"
  for name in "${targets[@]}"; do
    local port pidfile pid
    port=$(server_field "$name" port)
    pidfile="$PID_DIR/${name}.pid"

    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
      echo "  ✓ $name (localhost:$port) PID $(cat "$pidfile")"
    elif [ -f "$pidfile" ]; then
      echo "  ✗ $name (localhost:$port) — stale PID $(cat "$pidfile")"
    else
      echo "  ✗ $name (localhost:$port) — not running"
    fi
  done
}

# Main
case "${1:-help}" in
  start)   do_start "${@:2}" ;;
  stop)    do_stop "${@:2}" ;;
  status)  do_status "${@:2}" ;;
  cmd)     name="${2:?usage: serve cmd <server>}"; backend=$(server_field "$name" backend)
           if [ "$backend" = "mlx" ]; then build_mlx_cmd "$name"
           elif [ "$backend" = "optiq" ]; then build_optiq_cmd "$name"
           elif [ "$backend" = "mlxserve" ]; then build_mlxserve_cmd "$name"
           elif [ "$backend" = "sushi" ]; then build_sushi_cmd "$name"
           else build_llamacpp_cmd "$name"; fi; echo ;;
  *)       echo "Usage: $0 {start|stop|status|cmd} [server1] [server2] ..."
           echo ""
           echo "  cmd <server> — print the resolved command line without starting"
           echo "  FORCE=1 start — skip same-port collision guard"
           echo ""
           echo "Available servers:"
           list_servers | sed 's/^/  /'
           echo ""
           echo "Without server names, operates on all servers." ;;
esac
